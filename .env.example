# ── Database Configuration ──────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sports_club_db

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ── Email Configuration (Nodemailer / Gmail SMTP) ────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=Sports Club Management <your_email@gmail.com>

# ── AI Assistant Configuration ────────────────────────────────────────────────
AI_API_KEY=YOUR_API_KEY
AI_MODEL=gemini-2.5-flash
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# ── Backend public URL (used for certificate/receipt download links) ───────────
BACKEND_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173

# ── Razorpay Configuration (TEST MODE) ────────────────────────────────────────
# Get your keys from: https://dashboard.razorpay.com/app/keys  (select Test Mode)
# NEVER expose RAZORPAY_KEY_SECRET to the frontend
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
